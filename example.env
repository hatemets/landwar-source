# LandWar: local development (see docs/LANDWAR-CHANGES.md)
# Postgres. Run "docker compose up -d", then "pnpm run db:migrate".
DATABASE_URL=postgres://landwar:landwar@localhost:5432/landwar_dev
# The server applies pending migrations when it starts. Set to "true" to skip.
SKIP_MIGRATIONS=
# Public origin of the site. Google redirects back to this origin. Use HTTPS
# in staging and production; those environments reject a missing origin.
PUBLIC_ORIGIN=http://localhost:8888
# Signs session cookies and join tokens. Required in staging and production;
# use a unique value of at least 32 characters per environment. Generate with:
# openssl rand -base64 48
SESSION_SECRET=
# Google OAuth client (free). Redirect URI:
# http://localhost:8888/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" only if a cluster API exists to check in with. Off by default,
# so the master schedules public lobbies by itself.
CLUSTER_CHECKIN=

# Optional CDN origin (e.g. https://cdn.example.com) prepended to hashed asset
# URLs from asset-manifest.json. Leave empty to serve assets from the same
# origin as the app. No trailing slash.
CDN_BASE=

# Production config is not set here. See docs/Deploy.md.
